<%- include("../partials/nav.ejs", { bot, user, path, title: "Cakesito | Objetos" }) %>
<%- include("../partials/sidebar.ejs", { bot, user, path }) %>

<head>
    <link rel="stylesheet" type="text/css" href="/settings.css">
    <link rel="stylesheet" type="text/css" href="/objects.css">
</head>

<div class="container">
    <div class="alert-container"></div>

    <div class="guild">
        <%- guild.icon ? `<img src="https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}">` : `<img src="https://cdn.discordapp.com/embed/avatars/0.png">` %>
        <p><%= guild.name %></p>
    </div>

    <p class="title">Objetos</p>
    <div>
        <p class="description">Los objetos se consguien a través del comando <p class="description marked">craft</p>usando materiales. Los objetos pueden ser usados como divisa en la tienda.</p><br>
        <p class="title available-text">Objetos disponibles (<%= settings.craft.items.length ?? 0 %>/10)</p><br>
    </div>

    <div class="objects-container">
        <div id="add-object">
            <svg xmlns="http://www.w3.org/2000/svg" fill="#959595" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
            </svg>
        </div>

        <div class="invisible" id="object-template">
            <p class="title" style="font-style: italic;">Sin nombre</p>
        </div>

        <% if (settings.craft.items.length) { %>
            <% settings.craft.items.forEach(item => {  %>
                <div class="object" id="<%= item.name %>">
                    <input hidden class="invisible jijiji" id="info-<%= item.name %>" value="<%= JSON.stringify(item) %>" ></input>
                    <p class="title name"><%= item.name %> </p>
                    <p class="desc" style="text-align: center;" ><%= item.description %></p>
                    <p class="secondary prob">Prob. de éxito: <%= item.probability %> %</p>

                    <% Object.keys(item.materials).forEach(material => { %>
                        <p class="secondary">x<%= item.materials[material] %> <%= material %></p>
                    <% }) %>
                </div>
            <% }); %>
        <% } %>

    </div><br>

    <div class="layer"></div>
    <div class="object-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="object-info-close" viewBox="0 0 16 16">
            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
        </svg>
        
        <p class="description" style="color: #ec5454">Los cambios NO se guardan automáticamente.</p><br><br>
        <p class="subtitle">Nombre del objeto</p>
        <input id="object-info-name" type="text">
        <p class="subtitle">Descripción</p>
        <input id="object-info-description" type="text">
        <p class="subtitle">Probabilidad de obtenerlo al crearlo</p>
        <input id="object-info-probability" type="number">
        <p class="help">%</p><br>

        <div class="active-materials">
            <p class="subtitle">Materiales necesarios</p>
        </div>

        <div class="material-list-list">
            <p class="subtitle">Lista de materiales</p>
            <% if (settings.materials.length) { %>
                <% settings.materials.forEach(material => { %>
                    <p class="material-list" id="material-<%= material.name %>" ><%= material.name %> <svg xmlns="http://www.w3.org/2000/svg" fill="#fff" class="down" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z"/></svg></p>
                <% }); %>
            <% } else { %>
                <p style="color: #959595">No hay materiales</p>
            <% } %>
        <br>
        </div><br>
        <button class="save <%= settings.materials.length ? '' : 'no-materials'  %>" id="save" <%= settings.materials.length ? '' : 'disabled'  %> >Guardar cambios</button><br><br>
        <button class="caution" id="delete-object">Eliminar</button>
        <br>
                
    </div>

</div>
<script type="text/javascript" src="/objects.js"></script>

<%- include("../partials/nav.ejs", { bot, user, path, title: "Cakesito | Prefix" }) %>
<%- include("../partials/sidebar.ejs", { bot, user, path }) %>

<head>
  <link rel="stylesheet" href="/settings.css">
  <style>
    #sidebar-general {
      color: #fff;
      background-color: #3a3b3c;
      border-radius: 5px;
    }
  </style>
</head>

<div class="container">
  <div class="alert-container"></div>
  <div class="content">
    <div class="guild">
      <%- guild.icon ? `<img src="https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}">` : `<img src="https://cdn.discordapp.com/embed/avatars/0.png">` %>
      <p><%= guild.name %></p>
    </div>
    <p class="title">Prefix</p>
    <p class="description"><%= __("general.prefixDesc") %></p><br>
    <input type="text" id="prefix" value="<%= settings.prefix %>" placeholder="Prefix">
    <br><button class="save" id="save-prefix"><%= __("saveSettingsIn") %> Prefix</button>
    <br>
    <br>
    
    <div class="divider divider-special" style="justify-content: flex-start;">
      <div>
        <p class="title"><%= __("general.currency") %></p>
        <p class="subtitle">Emoji</p>
        <p class="description"><%= __("general.emojiDesc") %></p><br>
        <p class="description"><%= __("general.specifyEmoji_1") %> <p class="marked description"><:nombre:id></p> o <p class="marked description"></p> <%= __("general.specifyEmoji_2") %></p>
        <input id="currency-emoji" value="<%= settings.convertion.emoji %>"><br><br>
        
        <p class="subtitle"><%= __("general.name") %></p>
        <p class="description"><%= __("general.nameDesc") %></p><br>

        <input id="currency-name" value="<%= settings.convertion.name %>"></input><br>
        <img class="symbol" style="width: 1.5rem; height: auto; display: inline-block; position: relative; top: 5px;"></img>
        <p class="description" style="color: #959595">100</p>
        <p class="description" id="add"></p><br>
        <br><button class="save" id="save-currency"><%= __("saveSettingsIn") %> <%= __("general.currency") %></button>
      </div>

      <div>
        <p class="title"><%= __("general.howToEmoji") %></p>
        <p class="description"><%= __("general.addSlashBefore") %></p>
        <p class="description"><%= __("general.emojiWarning") %></p><br><br>
        <img src="/others/emoji.gif" style="max-width: 100%;"></img>
      </div>
    </div>

  </div><br>
</div>

<script type="text/javascript" src="/general.js"></script>
<%- include("../partials/nav.ejs", { bot, user, path, title: "Cakesito | Daily - Claim" }) %>
<%- include("../partials/sidebar.ejs", { bot, user, path }) %>

<head>
    <link rel="stylesheet" type="text/css" href="/settings.css">
    <link rel="stylesheet" type="text/css" href="/daily-claim.css">
</head>

<div class="container">
  <div class="alert-container"></div>
      
    <div class="guild">
      <%- guild.icon ? `<img src="https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}">` : `<img src="https://cdn.discordapp.com/embed/avatars/0.png">` %>
      <p><%= guild.name %></p>
    </div>
      
    <div class="divider divider-special">

      <div style="min-width: 30vw;  max-width: 30vw;">
        <p class="title">Daily</p>
        <p class="description" ><%= __("daily.desc") %></p><br><br>

        <div>
          <div class="select-type">
            <div class="div-money div-money-daily markable daily-markable" id="<%= settings.daily.reward.type == 'cash' ? 'daily-selected' : '' %>">
              <p class="subtitle">Dinero</p>
              <input type="number" id="input-money-daily" value="<%= settings.daily.reward.type == 'cash' ? settings.daily.reward.amount : '' %>" placeholder="Cantidad">
            </div>
            
            <div id="<%= settings.daily.reward.type == 'inv.' ? 'daily-selected' : '' %>" <%- (settings.craft.items.length || settings.materials.length) ? `class=" div-objects-daily markable daily-markable"` : 'class="div-objects-daily markable disabled"' %> >
                <p class="subtitle"><%= __("objectsMaterials") %></p>
    
                <% if (settings.craft.length || settings.materials.length) { %>
                  
                  <% var selectedMaterials = [];
                  if (settings.daily.reward.type == 'inv.') {
                    settings.daily.reward.materials.forEach(x => selectedMaterials.push(x.ref_id));
                  } %>

                  <% if (settings.craft.items.length) { %>
                    <% let selectedObject; %>
                    <select id="select-objects-daily">
                      <option value="Nada"><%= __("nothing") %></option>
                      <% settings.craft.items.forEach(x => { %>
                        <% if (selectedMaterials.includes(x.id)) { %>
                          <% selectedObject = x.id %>
                          <option selected value="<%= x.id %>"><%= x.name %></option>
                        <% } else { %>
                          <option value="<%= x.id %>"><%= x.name %></option>
                        <% } %>
                      <% }); %>
                    </select>
                        
                    <p class="help">: <%= __("from") %> </p>
                    <input id="object-min-daily" type="number" placeholder="<%= __('min') %>" value="<%= settings.daily.reward.materials?.find(x => x.ref_id == selectedObject)?.amount[0] ?? '0' %>">
                    <p class="help"> <%= __("to") %> </p>
                    <input id="object-max-daily" type="number" placeholder="<%= __('max') %>" value="<%= settings.daily.reward.materials?.find(x => x.ref_id == selectedObject)?.amount[1] ?? '0' %>">
                    <br>
                  <% } %>
                  
                  <% if (settings.materials.length) { %>
                    <% let selectedMaterial; %>
                    <select id="select-materials-daily">
                      <option value="Nada"><%= __("nothing") %></option>
                      <% settings.materials.forEach(x => { %>
                        <% if (selectedMaterials.includes(x.id)) { %>
                          <% selectedMaterial = x.id %>
                          <option selected value="<%= x.id %>"><%= x.name %></option>
                        <% } else { %>
                          <option value="<%= x.id %>"><%= x.name %></option>
                        <% } %>
                      <% }); %>
                    </select>
    
                    <p class="help">: <%= __("from") %> </p>
                    <input id="material-min-daily" type="number" placeholder="<%= __('min') %>" value="<%= settings.daily.reward.materials?.find(x => x.ref_id === selectedMaterial)?.amount[0] ?? '0' %>">
                    <p class="help"> <%= __("to") %> </p>
                    <input id="material-max-daily" type="number" placeholder="<%= __('max') %>" value="<%= settings.daily.reward.materials?.find(x => x.ref_id === selectedMaterial)?.amount[1] ?? '0' %>">
                    <br>
    
                  <% } %>
    
                <% } else { %>
                    <select disabled>
                        <option><%= __("notAvailable") %></option>
                    </select>
                <% } %>
            </div>

          </div>
        </div>

      </div>

      <div style="width: 65%;">
        <p class="title">Daily - <%= __("persText") %></p>

        <%- include("../partials/texts/money.ejs") %>
        <%- include("../partials/texts/materials.ejs") %>
        <%- include("../partials/texts/objects.ejs") %>
        <%- include("../partials/texts/timestamp.ejs") %>

        <br><p class="description"><%= __("leaveBlank") %></p><br>

        <div class="custom-text-text" id="custom-text-1">
          <div class="custom-text">
              <div class="yet-another-div">
                <textarea rows="5" maxlength="2000"><%= settings.daily.txt || '{}' %></textarea>
              </div>
          </div>
        </div>

      </div>
      
    </div>
  
    <br>
    <button class="save" id="save-daily"><%= __("saveSettingsIn") %> Daily</button>
    <br>
    <br>

    <div class="divider divider-special">

      <div style="min-width: 30vw; max-width: 30vw;">
        <p class="title">Claim</p>
        <p class="description claim-description"><%= __("claim.desc") %></p>
        <input type="text" class="claim-input" id="claim-cooldown" value="<%= settings.claim.cooldown %>">
        
        <div>
          <div class="select-type">
            <div class="div-money div-money-claim markable claim-markable" id="<%= settings.claim.reward.type == 'cash' ? 'claim-selected' : '' %>">
              <p class="subtitle">Dinero</p>
              <input type="number" id="input-money-claim" value="<%= settings.claim.reward.type == 'cash' ? settings.claim.reward.amount : '' %>" placeholder="Cantidad">
            </div>

            <div id="<%= settings.claim.reward.type == 'inv.' ? 'claim-selected' : '' %>"  <%- (settings.craft.items.length || settings.materials.length) ? `class="div-objects-claim markable claim-markable"` : 'class="div-objects-claim markable disabled"' %> >
                <p class="subtitle"><%= __("objectsMaterials") %></p>
      
                <% if (settings.craft.length || settings.materials.length) { %>
                  
                  <% var selectedMaterials = [];
                  if (settings.claim.reward.type == 'inv.') {
                    settings.claim.reward.materials.forEach(x => selectedMaterials.push(x.ref_id));
                  } %>

                  <% if (settings.craft.items.length) { %>
                    <% let selectedObject; %>
                    <select id="select-objects-claim">
                      <option value="Nada"><%= __("nothing") %></option>
                      <% settings.craft.items.forEach(x => { %>
                        <% if (selectedMaterials.includes(x.id)) { %>
                          <% selectedObject = x.id %>
                          <option selected value="<%= x.id %>"><%= x.name %></option>
                        <% } else { %>
                          <option value="<%= x.id %>"><%= x.name %></option>
                        <% } %>
                      <% }); %>
                    </select>
    
                    <p class="help">: <%= __("from") %> </p>
                    <input id="object-min-claim" type="number" placeholder="<%= __('min') %>" value="<%= settings.claim.reward.materials?.find(x => x.ref_id === selectedObject)?.amount[0] ?? '0' %>">
                    <p class="help"> <%= __("to") %> </p>
                    <input id="object-max-claim" type="number" placeholder="<%= __('max') %>" value="<%= settings.claim.reward.materials?.find(x => x.ref_id === selectedObject)?.amount[1] ?? '0' %>">
                    <br>
                  <% } %>
                  
                  <% if (settings.materials.length) { %>
                    <% let selectedMaterial; %>
                    <select id="select-materials-claim">
                      <option value="Nada"><%= __("nothing") %></option>
                      <% settings.materials.forEach(x => { %>
                        <% if (selectedMaterials.includes(x.id)) { %>
                          <% selectedMaterial = x.id %>
                          <option selected value="<%= x.id %>"><%= x.name %></option>
                        <% } else { %>
                          <option value="<%= x.id %>"><%= x.name %></option>
                        <% } %>
                      <% }); %>
                    </select>
    
                    <p class="help">: <%= __("from") %> </p>
                    <input id="material-min-claim" type="number" placeholder="<%= __('min') %>" value="<%= settings.claim.reward.materials?.find(x => x.ref_id === selectedMaterial)?.amount[0] ?? '0' %>">
                    <p class="help"> <%= __("to") %> </p>
                    <input id="material-max-claim" type="number" placeholder="<%= __('max') %>" value="<%= settings.claim.reward.materials?.find(x => x.ref_id === selectedMaterial)?.amount[1] ?? '0' %>">
                    <br>
    
                  <% } %>
    
                <% } else { %>
                    <select disabled>
                        <option><%= __("notAvailable") %></option>
                    </select>
                <% } %>
            </div>

          </div>
        </div>

      </div>
      
      <div style="width: 65%;">
        <p class="title">Claim - <%= __("persText") %></p>
        <%- include("../partials/texts/money.ejs") %>
        <%- include("../partials/texts/materials.ejs") %>
        <%- include("../partials/texts/objects.ejs") %>
        <%- include("../partials/texts/timestamp.ejs") %>
        
        <br><p class="description"><%= __("leaveBlank") %></p><br>

        <div class="custom-text-text" id="custom-text-2">
          <div class="custom-text">
              <div class="yet-another-div">
                <textarea rows="5" maxlength="2000"><%= settings.claim.txt || '{}' %></textarea>
              </div>
          </div>
        </div>

      </div>
    
    </div>
    
    <br>
    <button class="save" id="save-claim"><%= __("saveSettingsIn") %> Claim</button><br><br>
</div>

<script src="/daily-claim.js" type="module"></script>
<script src="/daily-claim1.js" type="module"></script>
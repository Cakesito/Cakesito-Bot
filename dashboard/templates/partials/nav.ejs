
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" type="text/css" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
</head>

<body>
    <nav class="navbar">
        <ul class="left">
            <li class="left-l"><a href="/">Cakesito</a></li>
            <li class="left-l"><a href="mailto: suggest@cakesito.xyz">Sugerencias</a></li>    
        </ul>
        <div class="right">
        <% if (user) { %>
            <img class="avatar" src="https://cdn.discordapp.com/avatars/508356344819220492/<%= user.avatar %>.png">           
            <p class="username"> <%= user.username %> </p>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#fff" class="chevron" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/>
            </svg>
            <li class="dropdown">
                <div class="dropdown-content">
                    <a class="nav-dashboard" href="/dashboard">Dashboard</a>
                    <a class="logout" href="/logout" >Log out</a>
                </div>
            </li>
        <% } else { %>
            <li class="login"><a href="/login">Login<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#fff" class="login-arrow" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
            </svg></a></li>
        <% } %>
        </div>
    </nav>
</body>
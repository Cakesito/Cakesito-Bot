<%- include("partials/nav.ejs", { bot, user, path, title: "Cakesito | Selecccionar servidor" }) %>

<head>
  <link rel="stylesheet" href="/select.css">
</head>

<div class="main">
  <div class="main-con">
    <% user.guilds.forEach(guild => {
        const permsOnGuild = new perms(guild.permissions_new);
        if(!permsOnGuild.has(perms.Flags.ManageGuild)) return;
    %>

      <% 
        var availableGuilds = [];
        var inviteGuilds = [];
        if (bot.guilds.cache.get(guild.id)) {
          availableGuilds.push(guild);

        } else inviteGuilds.push(guild);
      %>

      <% availableGuilds.forEach(x => { %>
        <div class="card">
          <div class="card-body">
            <%- guild.icon ? `<img src="https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}" class="card-img-top">` : `<img src="https://cdn.discordapp.com/embed/avatars/0.png" class="card-img-top">` %>
            <h5 class="card-title"><%= guild.name %></h5>
            <a href="/dashboard/<%- guild.id %>" class="button"><%= __("dashboard.settings") %></a>
          </div>
        </div>
      <% }); %>

      <% inviteGuilds.forEach(x => { %>
        <div class="card">
          <div class="card-body">
            <%- x.icon ? `<img src="https://cdn.discordapp.com/icons/${x.id}/${x.icon}" class="card-img-top">` : `<img src="https://cdn.discordapp.com/embed/avatars/0.png" class="card-img-top">` %>
            <h5 class="card-title"><%= x.name %></h5>
            <a href="<%= `https://discordapp.com/oauth2/authorize?client_id=${bot.user.id}&scope=bot&guild_id=${guild.id}&response_type=code&redirect_uri=${encodeURIComponent('https://cakesito.xyz/callback')}`  %>" class="button invite"><%= __("dashboard.invite") %></a>
          </div>
        </div>
      <% }); %>

    <% }); %>
  </div>

  <div class="blank"></div>

  <%- include("partials/footer.ejs", { bot }) %>
</div>